# 한국은행 ECOS Open API 인증키 (https://ecos.bok.or.kr -> Open API -> 인증키 신청, 무료)
# 이 파일을 .env 로 복사해 값을 채운다. 없으면 ECOS 수집만 건너뛴다.
# 실제 키는 .env 에만 둔다. .env 는 Git 제외이고, 이 파일은 공개 저장소에 올라간다.
ECOS_API_KEY=

# FRED API 키 (https://fred.stlouisfed.org/docs/api/api_key.html, 무료). 있으면 API 서버로, 없으면 CSV 엔드포인트로 받는다.
FRED_API_KEY=

# KRX Open API 키 (https://openapi.krx.co.kr, 무료). 발급 후 '지수 > 파생상품지수 일별시세' 서비스 신청·승인 필요. VKOSPI 수집용
KRX_API_KEY=
